# StackReel configuration — copy to ".env" in the project root.
#   Windows (PowerShell):  Copy-Item .env.example .env
# Every value is optional; the defaults below are what StackReel uses without a .env.
# Never commit your real .env (it is git-ignored).

# ── Ports ──────────────────────────────────────────────────────────────────
# The API server port. The Vite dev proxy reads this same file, so changing it
# here keeps the frontend and backend in sync automatically.
PORT=5001
# The frontend dev server port (strict: Vite fails instead of silently moving).
CLIENT_PORT=5173
# Interface the API binds to. Use 0.0.0.0 only if you deliberately expose it on your network.
HOST=127.0.0.1

# ── CORS ───────────────────────────────────────────────────────────────────
# http://localhost:<CLIENT_PORT> and http://127.0.0.1:<CLIENT_PORT> are always allowed in development.
# Add extra browser origins (comma-separated), e.g. a deployed frontend:
# CORS_ORIGINS=https://stackreel.example.com

# Only needed if the frontend calls an API on a different origin (not needed for `npm run dev`).
# VITE_API_URL=https://api.stackreel.example.com

# ── Storage ────────────────────────────────────────────────────────────────
# Projects and rendered videos are stored here (relative to the project root).
DATA_DIR=server/.data
MAX_PROJECTS=50

# ── Website analysis ───────────────────────────────────────────────────────
BROWSER_ANALYSIS=true
# Optional: use an existing Chrome/Chromium instead of `npm run setup:browser`.
#   Windows example: C:\Program Files\Google\Chrome\Application\chrome.exe
# BROWSER_EXECUTABLE_PATH=
ALLOWED_TARGET_PORTS=80,443,8080,8443
MAX_REDIRECTS=5
HTTP_TIMEOUT_MS=12000
BROWSER_TIMEOUT_MS=25000
MAX_HTML_BYTES=2000000
MAX_BROWSER_REQUESTS=300
MAX_CONCURRENT_ANALYSES=2

# ── Narration voice (text-to-speech) ───────────────────────────────────────
# auto        = your OS voice if available (Windows SAPI / macOS say / Linux espeak-ng), else meSpeak
# system      = OS voice only
# mespeak     = built-in offline voice (works everywhere, robotic)
# openai      = OpenAI TTS (needs OPENAI_API_KEY, paid)
# elevenlabs  = ElevenLabs (needs ELEVENLABS_API_KEY, paid)
TTS_PROVIDER=auto
# OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Optional LLM narration polish ──────────────────────────────────────────
# none (default) | anthropic | openai. The LLM only rewrites wording of the
# evidence-based script; its output is schema-validated and rejected if it
# mentions technologies that were not detected.
LLM_PROVIDER=none
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# OPENAI_MODEL=gpt-4o-mini

# ── Video rendering ────────────────────────────────────────────────────────
MAX_CONCURRENT_RENDERS=1
MAX_VIDEO_SECONDS=420
RENDER_TIMEOUT_MS=1200000
# Optional: use your own FFmpeg instead of the bundled one.
# FFMPEG_PATH=
# FFPROBE_PATH=

# ── Misc ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
RATE_LIMIT_ANALYSES=10
RATE_LIMIT_RENDERS=6
